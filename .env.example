# Source mode remains mock until connector parity is approved. Live mode is
# deliberately fail-closed.
DASHBOARD_DATA_MODE=mock

# Local development reads fixtures in memory. Set this to supabase only after
# Auth, migrations, memberships, and the server-only worker secret are ready.
DASHBOARD_DATA_STORE=fixture

# Local development automatically uses a non-production preview identity when
# DASHBOARD_AUTH_MODE is omitted. Production fails closed unless this is set to
# supabase and both NEXT_PUBLIC variables below are configured.
DASHBOARD_AUTH_MODE=supabase
# Local QA only when auth mode resolves to preview:
# DASHBOARD_PREVIEW_ROLE=viewer
# Optional comma-separated sign-in allowlist. Unset means any existing Supabase
# user may attempt sign-in; workspace access is still decided by memberships.
# Accounts are created by an admin: sign-in never creates or repairs a user.
# AUTH_ALLOWED_EMAILS=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=

# Reserved for trusted server-side workers only. Never expose this to browser
# code and do not configure it until a worker gate is approved.
SUPABASE_SERVICE_ROLE_KEY=

# Direct API Connectors & OAuth 2.0 (Server-side only)
# Authorized OAuth Redirect URI pattern:
# http://localhost:3000/api/connectors/oauth/[platform]/callback

# Google Ads API & OAuth
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_REFRESH_TOKEN=
# GOOGLE_ADS_CUSTOMER_ID=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Defaults to v19 when unset.
# GOOGLE_ADS_API_VERSION=
# Conversion action ids for the registration (SIGNUP) and order (PURCHASE)
# actions, read from the account's conversion settings.
# Leave either unset and the connector reports 0 for that event rather than
# guessing. Never point these at a dwell-time action such as "Time on Site - 60 Seconds" or
# any other PAGE_VIEW action; the connector refuses such a mapping.
# GOOGLE_ADS_REGISTRATION_CONVERSION_ACTION_ID=
# GOOGLE_ADS_PURCHASE_CONVERSION_ACTION_ID=
# Pins the reporting currency. A mismatch fails the pull closed.
# GOOGLE_ADS_EXPECTED_CURRENCY=USD
# Row key used to read the refresh token out of connector_tokens.
# GOOGLE_ADS_CLIENT_SLUG=kopi-senja
# Set to false to skip the per-campaign breakdown.
# GOOGLE_ADS_INCLUDE_CAMPAIGN_BREAKDOWN=true
# Set to false to skip search_term_view. It is only queried for a brand that
# runs a Search or Shopping campaign, and needs the campaign breakdown.
# GOOGLE_ADS_INCLUDE_SEARCH_TERMS=true
# Set to false to skip ad groups and Performance Max asset groups. Each level is
# only queried for a brand that actually runs it.
# GOOGLE_ADS_INCLUDE_ENTITY_BREAKDOWN=true
# Set to false to skip user_location_view (country and region grain; city is
# never pulled).
# GOOGLE_ADS_INCLUDE_GEO_BREAKDOWN=true
# Set to false to skip ad_group_audience_view.
# GOOGLE_ADS_INCLUDE_AUDIENCE_BREAKDOWN=true
#
# Per-brand Google Ads mapping. The unsuffixed customer id, refresh token and
# conversion action ids above serve the pilot (kopi-senja) only. Every other
# brand resolves its customer id from its own connector_tokens row first, then
# from its suffixed variable; nothing falls back to the pilot's account, and two
# brands mapped to one customer id both refuse to sync.
# GOOGLE_ADS_CUSTOMER_ID_BATIK_LESTARI=
# GOOGLE_ADS_REGISTRATION_CONVERSION_ACTION_ID_BATIK_LESTARI=
# GOOGLE_ADS_PURCHASE_CONVERSION_ACTION_ID_BATIK_LESTARI=
# Repeat with _RUMAH_RAJUT, _JAMU_ALAMI and _KRIYA_BALI.
# Optional per brand: GOOGLE_ADS_REFRESH_TOKEN_<SLUG>, GOOGLE_ADS_LOGIN_CUSTOMER_ID_<SLUG>.

# Meta Marketing API & OAuth
# META_APP_ID=
# META_APP_SECRET=
# Device-local fallback only. An active connector_tokens row wins over this.
# META_ADS_ACCESS_TOKEN=
# META_AD_ACCOUNT_ID=
# META_GRAPH_API_VERSION=v20.0
# Kopi Senja Nusantara lives in the shared Nusantara Group account; this marker is what
# keeps another brand's spend out of these rows. The trailing dot is deliberate.
# META_CAMPAIGN_NAME_FILTER=Kopi senja.
# META_EXPECTED_CURRENCY=USD
# META_CLIENT_SLUG=kopi-senja
# Pins the connector to one advertiser and fails closed on anything else.
# Set this: META_AD_ACCOUNT_ID is a common name and may already be exported in
# the operating system environment for an unrelated Meta MCP server, in which
# case the app would otherwise inherit it silently.
# META_EXPECTED_AD_ACCOUNT_ID=act_<your-ad-account-id>
# META_INCLUDE_CAMPAIGN_BREAKDOWN=true

# Microsoft Advertising (Bing Ads) OAuth
# BING_ADS_CLIENT_ID=
# BING_ADS_CLIENT_SECRET=

# Logo.dev Image API (Publishable Key for Client-side Logo Rendering)
NEXT_PUBLIC_LOGO_DEV_TOKEN=

# Resend Email Integration (Alerting, Anomaly Notifications, Daily Digest)
# RESEND_API_KEY=re_xxxxxxxxx
# NOTIFICATION_EMAIL_TO=owner@satulayar.example
# NOTIFICATION_EMAIL_FROM=Satulayar <onboarding@resend.dev>

# Add real values only to .env.local or the deployment secret manager.
# Never commit account IDs, tokens, client secrets, or private document URLs.


